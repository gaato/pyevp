{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommits"
  ],
  "lockFileMaintenance": {
    "description": "Vulnerability PRs only fix direct dependencies; a daily lock file refresh lands transitive fixes within a day.",
    "enabled": true,
    "schedule": [
      "before 6am"
    ]
  },
  "packageRules": [
    {
      "description": "Merge lock file maintenance once CI passes; it leaves declared ranges alone.",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "GitHub Actions (non-major)"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned tool versions in shell scripts, annotated with a `# renovate:` comment",
      "managerFilePatterns": [
        "/^examples/site/scripts/build-css\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+[A-Z0-9_]+_VERSION=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ]
}
