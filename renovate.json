{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommits"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/.venv/**"
  ],
  "lockFileMaintenance": {
    "description": "Vulnerability PRs only fix direct dependencies; a daily lock file refresh lands transitive fixes within a day.",
    "enabled": true,
    "schedule": [
      "before 6am"
    ]
  },
  "packageRules": [
    {
      "description": "Merge lock file maintenance once CI passes; it leaves declared ranges alone.",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "The site image builds with UV_PYTHON_DOWNLOADS=never, so its base image must carry the Python that .python-version names; update both in one PR.",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "python",
        "docker.io/library/python"
      ],
      "groupName": "Python"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "GitHub Actions (non-major)"
    }
  ]
}
