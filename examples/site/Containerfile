# Image for pyevp.dev and mail.pyevp.dev; build from the repository root.
FROM --platform=$BUILDPLATFORM docker.io/library/python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS css
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY examples/site /src/examples/site
RUN bash examples/site/scripts/build-css.sh /out/site.css

FROM ghcr.io/astral-sh/uv:0.12.21@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711 AS uv

FROM docker.io/library/python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS build
COPY --from=uv /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /src
COPY . .
RUN uv sync --locked --no-dev --no-editable --package pyevp-example-site

FROM docker.io/library/python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928
COPY --from=build /src/.venv /src/.venv
COPY examples/site/app.py examples/site/verification_trace.py /app/
COPY examples/site/templates /app/templates
COPY --from=css /out/site.css /app/static/site.css
COPY examples/fastapi/app.py /app/examples/fastapi/app.py
COPY examples/flask/app.py /app/examples/flask/app.py
COPY examples/django/views.py /app/examples/django/views.py
ARG BUILD_SHA=unknown
ENV BUILD_SHA=$BUILD_SHA EVP_EXAMPLES_DIR=/app/examples
ENV PATH=/src/.venv/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR /app
USER 65534:65534
EXPOSE 8080
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080", "--no-server-header"]
